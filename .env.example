# Copy to .env and fill in. Never commit .env.
# The demo (/demo) and fee previews need none of these: they use public 1Click dry quotes.

# NEAR Intents Agent API: the passkey-owned, policy-locked wallet behind every payment link.
# Key from partners.demo.agentsonintents.com/dashboard
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=

# NEAR Intents 1Click partner key (partners.near-intents.org, type: Distribution Channel).
# Optional: quotes work without it, at 1Click's default fee.
NEAR_INTENTS_API_KEY=

# Encrypts stored grant tokens and signs sign-in cookies. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ALLOT_SECRET=

# Optional. Where the SQLite database lives (default: ./data/allot.db, or the attached volume on Railway).
# On Railway: /data/allot.db (volume).
# ALLOT_DB_PATH=./data/allot.db

# Optional. The background sweeper (keeps payments and splits moving) runs in production by default.
# Set "on" to also run it in dev, or "off" to disable it.
# ALLOT_SWEEPER=on

# Optional. How rate limiting finds the real client IP.
# A header your host's proxy always overwrites with it (e.g. x-real-ip, cf-connecting-ip, fly-client-ip).
# On Railway this defaults to x-real-ip; you don't need to set it there.
# ALLOT_CLIENT_IP_HEADER=x-real-ip
# Otherwise: proxies in front of the app, counted from the right of X-Forwarded-For (default 1).
# Set 2 if a CDN such as Cloudflare sits in front of the host.
# ALLOT_PROXY_HOPS=1
